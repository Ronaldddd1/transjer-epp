# Cadena de conexión PostgreSQL (Neon / Supabase). Usa la URL "pooled" para la app.
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST/DB?sslmode=require"
# URL directa (sin pooler) usada por las migraciones. Si no la defines se usa DATABASE_URL.
DIRECT_URL="postgresql://USUARIO:PASSWORD@HOST/DB?sslmode=require"

# Clave para firmar las sesiones. Genera una con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

# Usuario administrador inicial (lo usa el seed y scripts/create-admin.ts)
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@transjer.pe"
ADMIN_PASSWORD="CambiarEsta123!"

# ---------------------------------------------------------------------------
# FACTURAS DE PROVEEDORES  (todo lo de abajo es opcional)
# ---------------------------------------------------------------------------

# RUC de Transjer. Si lo defines, el sistema avisa cuando llega un comprobante
# emitido a otra empresa (correo equivocado).
COMPANY_RUC=""

# --- Dónde se guardan los PDF y XML de las facturas ---
# Si no configuras nada, se guardan dentro de la base de datos (máximo 3 MB por
# archivo). Para uso continuo conviene una de estas dos opciones:
#
# Opción A — Vercel Blob (sirve con Neon o con Supabase).
#   En Vercel: Storage > Blob. La variable se crea sola al conectarlo.
# BLOB_READ_WRITE_TOKEN=""
#
# Opción B — Supabase Storage (solo si tu base es Supabase).
#   Crea un bucket PRIVADO llamado "facturas" y copia la Service Role Key.
# SUPABASE_URL="https://xxxxxxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="facturas"

# --- Lectura automática del buzón facturas@transjer.com ---
#
# Hay dos caminos y basta con uno. Si están los dos, manda IMAP.
#
# Opción A — IMAP. Sirve con cualquier correo: el del hosting de la empresa, Gmail,
#   el que sea. No hace falta registrar nada ni pedir permisos a un administrador.
#   Los datos salen de la configuración del buzón (en cPanel, "Conectar dispositivos").
IMAP_HOST="mail.transjer.com"
IMAP_PORT="993"
IMAP_USER="facturas@transjer.com"
IMAP_PASSWORD=""
# Carpeta que se revisa. Por defecto la bandeja de entrada.
# IMAP_FOLDER="INBOX"
#
# IMAP no avisa cuando llega un correo, hay que preguntar. La tarea de vercel.json lo
# hace una vez al día; para revisarlo cada pocos minutos, que algo externo llame a
# /api/cron/facturas con CRON_SECRET. Ver el README.
#
# Opción B — Microsoft 365 (solo si la empresa lo tiene). Pide registrar una aplicación
#   en Entra ID con el consentimiento de un administrador, pero a cambio Microsoft avisa
#   en cuanto llega un correo. Ver el README, sección "Lectura automática del correo".
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
INVOICE_MAILBOX="facturas@transjer.com"
# Carpeta del buzón que se revisa (por defecto, la bandeja de entrada).
# INVOICE_MAIL_FOLDER="Inbox"
# Palabra secreta que Microsoft devuelve en cada aviso. Genera una con:
#   openssl rand -base64 24
GRAPH_WEBHOOK_SECRET=""

# Dirección pública del sistema, necesaria para que Microsoft pueda avisar.
# En Vercel se detecta sola; defínela solo si usas un dominio propio.
# APP_URL="https://epp.transjer.pe"

# Clave de la tarea diaria que renueva los avisos y repasa el buzón.
# Genera una con: openssl rand -base64 24
CRON_SECRET=""

# ---------------------------------------------------------------------------
# AVISOS DE VENCIMIENTO POR WHATSAPP  (opcional)
# ---------------------------------------------------------------------------

# Clave con la que el servidor de avisos del VPS pide qué vence pronto y avisa
# de vuelta qué mandó. Sin ella, /api/avisos/* responde 401 a todo el mundo.
# La misma cadena va en el archivo de variables del VPS.
# Genera una con: openssl rand -base64 32
AVISOS_SECRET=""
